#!/usr/bin/env bash
# This script audits DNS records for subdomains of a given domain

# Function to get DNS record information
get_dns_info() {
    local domain=$1
    local subdomain=$2
    local full_domain="${subdomain}.${domain}"
    
    # Use dig to get the DNS record
    local record=$(dig ${full_domain} A +short)
    local record_type="A"
    
    # If no A record, check for CNAME
    if [ -z "$record" ]; then
        record=$(dig ${full_domain} CNAME +short)
        record_type="CNAME"
    fi
    
    echo "$record_type $record"
}

# Function to display subdomain information
display_subdomain_info() {
    local domain=$1
    local subdomain=$2
    
    # Get DNS info
    local dns_info=$(get_dns_info "$domain" "$subdomain")
    local record_type=$(echo "$dns_info" | awk '{print $1}')
    local destination=$(echo "$dns_info" | awk '{print $2}')
    
    echo "The subdomain ${subdomain} is a ${record_type} record and points to ${destination}"
}

# Main script
if [ $# -eq 1 ]; then
    # Only domain provided - show all subdomains
    domain=$1
    display_subdomain_info "$domain" "www"
    display_subdomain_info "$domain" "lb-01"
    display_subdomain_info "$domain" "web-01"
    display_subdomain_info "$domain" "web-02"
elif [ $# -eq 2 ]; then
    # Domain and specific subdomain provided
    domain=$1
    subdomain=$2
    display_subdomain_info "$domain" "$subdomain"
else
    echo "Usage: $0 <domain> [subdomain]"
    exit 1
fi
