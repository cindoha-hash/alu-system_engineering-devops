#!/usr/bin/env bash
# This script installs and configures Nginx web server on a new Ubuntu machine

# Update package lists
sudo apt-get update -y

# Install Nginx web server (includes -y to auto-confirm)
sudo apt-get install -y nginx

# Ensure Nginx is running
sudo service nginx start

# Or use the init.d script (since systemctl is not allowed)
# sudo /etc/init.d/nginx start

# Create the HTML content with required string
echo "Holberton School for the win!" | sudo tee /var/www/html/index.nginx-debian.html

# Set proper permissions for the web root
sudo chown -R www-data:www-data /var/www/html/

# Ensure Nginx starts on boot
sudo update-rc.d nginx defaults

# Verify Nginx is running
sudo service nginx status
